# ManjuFlow runtime settings. Copy to .env and adjust; never commit real secrets.

# HTTP listener and storage
MANJU_HTTP_ADDR=:8080
MANJU_DB_PATH=./data/manjuflow.sqlite
MANJU_LOG_LEVEL=info
MANJU_REQUEST_TIMEOUT=20s
MANJU_SHUTDOWN_GRACE=15s

# Session lifecycle
MANJU_SESSION_TTL=12h

# Render pipeline
MANJU_RENDER_LEASE_TTL=30s
MANJU_RENDER_POLL_INTERVAL=500ms
MANJU_RENDER_BACKOFF_BASE=2s
MANJU_RENDER_MAX_ATTEMPTS=3
MANJU_DAILY_RENDER_CAPACITY=24

# Teaching housekeeping
MANJU_WORKSHOP_SWEEP_EVERY=5s

# Studio bootstrap. Leave the passwords empty to have the process generate a
# one-time credential and print it once at first start.
MANJU_STUDIO_SLUG=solo-studio
MANJU_STUDIO_NAME=一人漫剧工坊
MANJU_DIRECTOR_EMAIL=director@manjuflow.local
MANJU_DIRECTOR_PASSWORD=
MANJU_APPRENTICE_EMAIL=apprentice@manjuflow.local
MANJU_APPRENTICE_PASSWORD=
